{
  "name": "steamcommunity.bet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:generate": "turbo -F @steamcommunity.bet/db db:generate",
    "deploy": "turbo -F @steamcommunity.bet/infra deploy",
    "destroy": "turbo -F @steamcommunity.bet/infra destroy",
    "check": "oxlint && oxfmt --write",
    "test": "node --experimental-strip-types --test 'packages/**/*.test.ts'"
  },
  "dependencies": {
    "@steamcommunity.bet/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@steamcommunity.bet/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.26.0"
}
